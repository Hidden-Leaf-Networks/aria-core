# Aria Core API — Environment Configuration
# Copy to .env and fill in your values

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
ARIA_HOST=0.0.0.0
ARIA_PORT=8000
ARIA_DEBUG=false

# ---------------------------------------------------------------
# Authentication (REQUIRED)
# ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ARIA_JWT_SECRET=CHANGE_ME
ARIA_JWT_ALGORITHM=HS256
ARIA_JWT_ISSUER=aria-core
ARIA_JWT_AUDIENCE=aria-core-api

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
# memory = in-memory (development/single-tenant)
# postgres = PostgreSQL (production/multi-tenant)
ARIA_PERSISTENCE=postgres
ARIA_DATABASE_URL=postgresql+asyncpg://aria:aria@localhost:5432/aria_core

# Docker Compose PostgreSQL
POSTGRES_PASSWORD=aria
POSTGRES_PORT=5432

# ---------------------------------------------------------------
# CORS
# ---------------------------------------------------------------
# Comma-separated origins. Use * for development.
ARIA_CORS_ORIGINS=*
